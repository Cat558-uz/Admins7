e(\"Players\")\nlocal CoreGui = game:GetService(\"CoreGui\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ProximityPromptService = game:GetService(\"ProximityPromptService\")\nlocal LocalPlayer = Players.LocalPlayer\n\n-- 1. ANTI-BAN (BẮT BUỘC)\nlocal mt = getrawmetatable(game)\nlocal old = mt.__namecall\nsetreadonly(mt, false)\nmt.__namecall = newcclosure(function(self, ...)\n    local method = getnamecallmethod()\n    if method == \"Kick\" or method == \"kick\" then return nil end\n    return old(self, ...)\nend)\nsetreadonly(mt, true)\n\n-- 2. GIAO DIỆN CLASSIC (NHƯ ẢNH DUY GỬI)\nif CoreGui:FindFirstChild(\"DuyClassicFix\") then CoreGui.DuyClassicFix:Destroy() end\n\nlocal ScreenGui = Instance.new(\"ScreenGui\")\nScreenGui.Name = \"DuyClassicFix\"\nScreenGui.Parent = CoreGui\n\n-- Icon thu nhỏ\nlocal MiniBtn = Instance.new(\"TextButton\")\nMiniBtn.Size = UDim2.new(0, 45, 0, 45)\nMiniBtn.Position = UDim2.new(0.05, 0, 0.05, 0)\nMiniBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nMiniBtn.Text = \"VIP\"\nMiniBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nMiniBtn.Font = Enum.Font.SourceSansBold\nMiniBtn.TextSize = 18\nMiniBtn.Visible = false\nInstance.new(\"UICorner\", MiniBtn).CornerRadius = UDim.new(1, 0)\nMiniBtn.Parent = ScreenGui\n\n-- Frame Chính (Dẹt Ngang)\nlocal Main = Instance.new(\"Frame\")\nMain.Size = UDim2.new(0, 430, 0, 150)\nMain.Position = UDim2.new(0.5, -215, 0.15, 0)\nMain.BackgroundColor3 = Color3.fromRGB(255, 255, 255)\nMain.BorderSizePixel = 2\nMain.BorderColor3 = Color3.fromRGB(0, 0, 0)\nMain.Parent = ScreenGui\n\n-- Header\nlocal Header = Instance.new(\"Frame\")\nHeader.Size = UDim2.new(1, 0, 0, 35)\nHeader.BackgroundTransparency = 1\nHeader.Parent = Main\n\nlocal Title = Instance.new(\"TextLabel\")\nTitle.Text = \"  DUY VIP | CLASSIC - REACH - VFLY\"\nTitle.Size = UDim2.new(1, -70, 1, 0)\nTitle.Position = UDim2.new(0, 10, 0, 0)\nTitle.Font = Enum.Font.SourceSansBold\nTitle.TextSize = 16\nTitle.TextXAlignment = Enum.TextXAlignment.Left\nTitle.BackgroundTransparency = 1\nTitle.Parent = Header\n\nlocal CloseBtn = Instance.new(\"TextButton\")\nCloseBtn.Text = \"X\"\nCloseBtn.Size = UDim2.new(0, 35, 1, 0)\nCloseBtn.Position = UDim2.new(1, -35, 0, 0)\nCloseBtn.BackgroundTransparency = 1\nCloseBtn.TextSize = 25\nCloseBtn.Parent = Header\n\nlocal Line = Instance.new(\"Frame\")\nLine.Size = UDim2.new(1, 0, 0, 2)\nLine.Position = UDim2.new(0, 0, 0, 35)\nLine.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nLine.Parent = Main\n\n-- Ô Tọa độ & LAST\nlocal PosBox = Instance.new(\"TextBox\")\nPosBox.Size = UDim2.new(0.75, -15, 0, 35)\nPosBox.Position = UDim2.new(0, 10, 0, 45)\nPosBox.BackgroundColor3 = Color3.fromRGB(240, 240, 240)\nPosBox.Text = \"Coordinates: 0, 0, 0\"\nPosBox.Font = Enum.Font.SourceSansBold\nPosBox.TextSize = 15\nPosBox.ClearTextOnFocus = false\nPosBox.Parent = Main\n\nlocal LastBtn = Instance.new(\"TextButton\")\nLastBtn.Text = \"LAST\"\nLastBtn.Size = UDim2.new(0.25, -15, 0, 35)\nLastBtn.Position = UDim2.new(0.75, 5, 0, 45)\nLastBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 200)\nLastBtn.TextSize = 12\nLastBtn.Parent = Main\n\n-- Nút Chức Năng (Dàn ngang)\nlocal function CreateBtn(txt, xPos)\n    local b = Instance.new(\"TextButton\")\n    b.Text = txt\n    b.Size = UDim2.new(0.18, 0, 0, 45)\n    b.Position = UDim2.new(xPos, 0, 0, 90)\n    b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)\n    b.BorderSizePixel = 1\n    b.BorderColor3 = Color3.fromRGB(0, 0, 0)\n    b.Font = Enum.Font.SourceSansBold\n    b.TextSize = 14\n    b.Parent = Main\n    return b\nend\n\nlocal BtnCheck = CreateBtn(\"CHECK\", 0.02)\nlocal BtnTP = CreateBtn(\"TP\", 0.22)\nlocal BtnReach = CreateBtn(\"REACH\", 0.42)\nlocal BtnVFly = CreateBtn(\"VFLY\", 0.62)\nlocal BtnHold = CreateBtn(\"HOLD\", 0.82)\n\n-- LOGIC\nlocal reachActive = false\nlocal vflyActive = false\nlocal lastPos = \"0, 0, 0\"\n\n-- 3. REACH (PHÓNG TO KIẾM)\ntask.spawn(function()\n    while task.wait(0.5) do\n        if reachActive then\n            local char = LocalPlayer.Character\n            local tool = char and char:FindFirstChildOfClass(\"Tool\")\n            if tool and tool:FindFirstChild(\"Handle\") then\n                tool.Handle.Size = Vector3.new(20, 20, 20) -- Phóng to cây kiếm 20x20\n                tool.Handle.Transparency = 0.8 -- Làm mờ để không vướng mắt\n                tool.Handle.Massless = true\n                tool.Handle.CanCollide = false\n            end\n        else\n            local char = LocalPlayer.Character\n            local tool = char and char:FindFirstChildOfClass(\"Tool\")\n            if tool and tool:FindFirstChild(\"Handle\") then\n                tool.Handle.Size = Vector3.new(1, 0.8, 4) -- Trả về kích thước gốc (tùy game)\n                tool.Handle.Transparency = 0\n            end\n        end\n    end\nend)\n\nBtnReach.MouseButton1Click:Connect(function()\n    reachActive = not reachActive\n    BtnReach.BackgroundColor3 = reachActive and Color3.fromRGB(200, 255, 200) or Color3.fromRGB(255, 255, 255)\n    BtnReach.Text = reachActive and \"REACH ON\" or \"REACH\"\nend)\n\n-- 4. VFLY FIX (BAY XE)\nBtnVFly.MouseButton1Click:Connect(function()\n    vflyActive = not vflyActive\n    BtnVFly.BackgroundColor3 = vflyActive and Color3.fromRGB(200, 255, 255) or Color3.fromRGB(255, 255, 255)\n    \n    local char = LocalPlayer.Character\n    local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\n    local seat = hum and hum.SeatPart\n    \n    if seat then\n        local p = seat.Parent.PrimaryPart or seat\n        if vflyActive then\n            local bv = Instance.new(\"BodyVelocity\", p)\n            bv.Name = \"DuyVFly\"\n            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)\n            bv.Velocity = Vector3.new(0, 0, 0)\n            \n            task.spawn(function()\n                while vflyActive and p.Parent do\n                    bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * 100\n                    task.wait()\n                end\n                bv:Destroy()\n            end)\n        else\n            if p:FindFirstChild(\"DuyVFly\") then p.DuyVFly:Destroy() end\n        end\n    end\nend)\n\n-- TP / CHECK\nBtnCheck.MouseButton1Click:Connect(function()\n    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\n    if h then\n        lastPos = PosBox.Text\n        PosBox.Text = string.format(\"%.1f, %.1f, %.1f\", h.Position.X, h.Position.Y, h.Position.Z)\n    end\nend)\n\nLastBtn.MouseButton1Click:Connect(function()\n    local cur = PosBox.Text\n    PosBox.Text = lastPos\n    lastPos = cur\nend)\n\nBtnTP.MouseButton1Click:Connect(function()\n    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\n    if h then\n        local t = {}\n        for s in string.gmatch(PosBox.Text, \"[^,]+\") do table.insert(t, tonumber(s)) end\n        if #t >= 3 then h.CFrame = CFrame.new(t[1], t[2], t[3]) end\n    end\nend)\n\n-- HOLD\nlocal isHold = true\nBtnHold.MouseButton1Click:Connect(function() isHold = not isHold BtnHold.Text = isHold and \"HOLD\" or \"OFF-H\" end)\nProximityPromptService.PromptButtonHoldBegan:Connect(function(p) if isHold then fireproximityprompt(p) p.HoldDuration = 0 end end)\n\n-- Kéo thả\nlocal function Drag(o, t)\n    local d, s, p\n    o.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then d = true s = i.Position p = t.Position end end)\n    UserInputService.InputChanged:Connect(function(i) if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then local delta = i.Position - s t.Position = UDim2.new(p.X.Scale, p.X.Offset + delta.X, p.Y.Scale, p.Y.Offset + delta.Y) end end)\n    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then d = false end end)\nend